# Copy to .env and fill in. Never commit .env.
# Passwords for Mongo must not contain '@' or ':' (they go into a connection string).
# Generate values with:  openssl rand -hex 24

RM_ADMIN_USER=admin
RM_ADMIN_PASSWORD=
# At least 32 characters; 64 recommended:  openssl rand -hex 32
RM_JWT_SECRET=

MONGO_ROOT_PASSWORD=
RM_MONGO_USER=racemgr
RM_MONGO_PASS=

# Only for docker/docker-compose.external-server.yml (game server runs in its own container)
# Host folder holding the game server files (the one with DedicatedServerCmd.exe and lua_config/)
AMS2_DATA_DIR=
# Who owns that folder (`ls -ln` on it). Synology users have IDs like 1026:100, not 1000:1000
# RACEMGR_UID=1000
# RACEMGR_GID=1000
# Use the published image instead of building one (slow on a NAS): docker compose ... pull, then up -d
# RACEMGR_IMAGE=ghcr.io/<owner>/race_mgr-external:v1.0.0
# Set to signal once the game server's container uses docker/game-server/entrypoint.sh (restart from Race Manager)
# RM_GAMESERVER_RESTART=signal
# Port Race Manager listens on (on 127.0.0.1 of the host). Change it if something else on the NAS uses 8080
# RM_PORT=8080
# Set to true when an HTTPS reverse proxy talks to Race Manager over plain HTTP
# RM_COOKIE_SECURE=true

# Optional: post race results and server up/down notices to a Discord channel
# RM_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional: "Sign in with Synology" (behind docker/docker-compose.sso-proxy.yml, see the README)
# RM_SSO_ISSUER=https://yourname.synology.me:4931/webman/sso
# RM_SSO_CLIENT_ID=
# DSM user names and/or groups (comma separated) that get a Race Manager role; everyone else can only look
# RM_SSO_ADMINS=
# RM_SSO_STEWARDS=
# RM_SSO_ADMIN_GROUPS=
# RM_SSO_STEWARD_GROUPS=

# Optional: read the ams2_stats addon's file (sector times, lap chart, DNF tracking) instead of sms_stats
# RM_STATS_SOURCE=ams2_stats
# RM_STATS_TIMEZONE=America/New_York
